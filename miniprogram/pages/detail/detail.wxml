<!--pages/detail/detail.wxml-->
<view class="container">
  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view wx:else>
    <!-- 事项信息卡片 -->
    <view class="item-card">
      <view class="item-icon" style="background: {{item.iconBg || '#07c160'}}">
        <text class="icon-text">{{item.icon || '📌'}}</text>
      </view>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-desc" wx:if="{{item.description}}">{{item.description}}</view>
        <view class="item-cycle">
          <text class="label">周期:</text>
          <text>{{item.cycleText || '每日'}}</text>
        </view>
      </view>
      <view
        class="check-btn-large {{item.todayChecked ? 'checked' : ''}}"
        bindtap="onCheckin"
      >
        <text wx:if="{{item.todayChecked}}">✓</text>
        <text wx:else>完成</text>
      </view>
    </view>

    <!-- 完成记录 -->
    <view class="section">
      <view class="section-title">完成记录</view>
      <view class="checkin-list" wx:if="{{checkins.length > 0}}">
        <view class="checkin-group" wx:for="{{checkins}}" wx:key="date">
          <view class="checkin-date">{{getDateDisplay(item.date)}}</view>
          <view class="checkin-users">
            <view class="checkin-user" wx:for="{{item.users}}" wx:for-item="checkin" wx:key="_id">
              <view class="user-avatar">
                <image src="{{checkin.userAvatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
              </view>
              <view class="user-info">
                <text class="user-name">{{checkin.userName}}</text>
                <text class="checkin-time">{{checkin.time}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="empty-text" wx:else>
        <text>暂无完成记录</text>
      </view>
    </view>

    <!-- 成员列表 -->
    <view class="section">
      <view class="section-title">参与成员 ({{members.length}})</view>
      <view class="member-list" wx:if="{{members.length > 0}}">
        <view class="member-item" wx:for="{{members}}" wx:key="_id">
          <view class="member-avatar">
            <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          </view>
          <view class="member-name">{{item.nickName}}</view>
          <view class="member-badge" wx:if="{{item._id === item.creatorId}}">创建者</view>
          <view
            class="remove-btn"
            wx:if="{{item._id !== item.creatorId && item.creatorId === userId}}"
            data-userId="{{item._id}}"
            catchtap="removeMember"
          >
            移除
          </view>
        </view>
      </view>
      <view class="empty-text" wx:else>
        <text>暂无成员</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-btns">
      <button class="btn btn-default" bindtap="showShareAction">分享给好友</button>
      <button class="btn btn-default" bindtap="generateQRCode">生成二维码</button>
      <button class="btn btn-default" wx:if="{{item.creatorId === userId}}" bindtap="goToEdit">编辑</button>
      <button class="btn btn-danger" wx:if="{{item.creatorId === userId}}" bindtap="deleteItem">删除</button>
    </view>
  </view>

  <!-- 分享菜单弹窗 -->
  <view class="share-menu" wx:if="{{showShareMenu}}" bindtap="closeShareMenu">
    <view class="share-content" catchtap="preventClose">
      <view class="share-title">分享到</view>
      <view class="share-options">
        <button class="share-option" open-type="share">
          <text class="icon">💬</text>
          <text>微信好友</text>
        </button>
        <view class="share-option" bindtap="generateQRCode">
          <text class="icon">📱</text>
          <text>二维码</text>
        </view>
      </view>
      <view class="cancel-btn" bindtap="closeShareMenu">取消</view>
    </view>
  </view>

  <!-- 二维码弹窗 -->
  <view class="qrcode-modal" wx:if="{{showQRCode}}" bindtap="closeQRCode">
    <view class="qrcode-content" catchtap="preventClose">
      <view class="qrcode-title">扫码加入</view>
      <image class="qrcode-image" src="{{qrCodeUrl}}" mode="aspectFit"></image>
      <view class="qrcode-tip">扫描二维码加入事项</view>
      <button class="btn btn-primary" bindtap="saveQRCode">保存到相册</button>
      <view class="close-qrcode" bindtap="closeQRCode">×</view>
    </view>
  </view>
</view>
