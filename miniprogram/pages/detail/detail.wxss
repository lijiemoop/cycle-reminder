/* pages/detail/detail.wxss */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.item-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.icon-text {
  font-size: 56rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.item-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.item-cycle {
  font-size: 24rpx;
  color: #999;
}

.item-cycle .label {
  margin-right: 8rpx;
}

.check-btn-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
  transition: all 0.2s;
}

.check-btn-large.checked {
  background: #07c160;
  border-color: #07c160;
  color: #fff;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.checkin-group {
  margin-bottom: 24rpx;
}

.checkin-date {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #07c160;
}

.checkin-user {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.checkin-user:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 16rpx;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  color: #333;
}

.checkin-time {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 16rpx;
}

.member-avatar image {
  width: 100%;
  height: 100%;
}

.member-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.member-badge {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f5e9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.remove-btn {
  font-size: 24rpx;
  color: #ff4d4f;
}

.empty-text {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}

.action-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.action-btns .btn {
  flex: 1;
  min-width: 200rpx;
}

/* 分享菜单弹窗 */
.share-menu {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.share-content {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  width: 100%;
}

.share-title {
  text-align: center;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 32rpx;
}

.share-options {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.share-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  line-height: normal;
}

.share-option .icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.share-option text:last-child {
  font-size: 26rpx;
  color: #666;
}

.cancel-btn {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 30rpx;
  border-top: 1rpx solid #f5f5f5;
}

/* 二维码弹窗 */
.qrcode-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.qrcode-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
  width: 600rpx;
  position: relative;
}

.qrcode-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.qrcode-image {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto;
  display: block;
}

.qrcode-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin: 24rpx 0 32rpx;
}

.close-qrcode {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}
