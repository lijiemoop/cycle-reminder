/* pages/index/index.wxss */
.header {
  padding: 24rpx 0;
  background: #fff;
  margin: -24rpx -24rpx 24rpx;
  padding: 32rpx 24rpx;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}

.date {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.item-list {
  padding-bottom: 120rpx;
}

.item-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-text {
  font-size: 44rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

.item-progress {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
  margin-right: 12rpx;
}

.progress-text.completed {
  color: #07c160;
}

.progress-status {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f5e9;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.check-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  transition: all 0.2s;
}

.check-btn.checked {
  background: #07c160;
  border-color: #07c160;
}

.add-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty text {
  color: #999;
  font-size: 28rpx;
}
